APP_NAME=Dahab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Password hashing: Argon2id (spec FR-X-007). Bcrypt hashes stay verifiable and are rehashed on next sign-in.
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dahab
DB_USERNAME=dahab
DB_PASSWORD=secret
DB_CHARSET=utf8
DB_SCHEMA=public
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Horizon
HORIZON_PREFIX=dahab-horizon:
HORIZON_DOMAIN=null
HORIZON_PATH=horizon

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SESSION_DOMAIN=null

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Mail — registration-success email.
# `log` writes the message to the log and needs no credentials; switch to
# `smtp` once the real mailbox is available.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@dahab.local"
MAIL_FROM_NAME="${APP_NAME}"

# SMS — registration OTP and registration-success SMS.
# `log` writes the message to the log and needs no credentials. Set
# SMS_DRIVER=http and fill in the rest once the provider is chosen; the
# SMS_FIELD_* keys map our payload onto that provider's request body.
SMS_DRIVER=log
SMS_SENDER_ID="${APP_NAME}"
SMS_LOG_CHANNEL=
SMS_BASE_URL=
SMS_ENDPOINT=/messages
SMS_API_KEY=
SMS_API_SECRET=
SMS_AUTH=bearer
SMS_AUTH_HEADER=X-API-Key
SMS_AUTH_QUERY_KEY=api_key
SMS_TIMEOUT=10
SMS_RETRIES=2
SMS_RETRY_DELAY_MS=250
SMS_FIELD_TO=to
SMS_FIELD_MESSAGE=message
SMS_FIELD_SENDER=sender

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# API
API_VERSION=v1

# Dahab Auth (feature 001-auth-customer-staff)
# How long an in-flight registration (start -> OTP -> complete) stays alive.
DAHAB_AUTH_REGISTRATION_SESSION_TTL_SECONDS=900
DAHAB_AUTH_ACCESS_TTL_MINUTES=15
DAHAB_AUTH_REFRESH_TTL_DAYS=30
DAHAB_AUTH_OTP_TTL_SECONDS=300
DAHAB_AUTH_OTP_MAX_VERIFY_ATTEMPTS=5
DAHAB_AUTH_OTP_SEND_COOLDOWN_SECONDS=60
DAHAB_AUTH_OTP_MAX_SENDS_PER_HOUR=5
DAHAB_AUTH_PASSWORD_CHECK_PWNED=true
# MFA is required for founders and for roles flagged requires_mfa (managed in the Dashboard).
# false turns the requirement off: local development only; always on in production.
# DAHAB_AUTH_MFA_ENFORCED=true
# Local/testing only: password for the per-role accounts LocalStaffSeeder creates (never seeded in staging/production).
DAHAB_LOCAL_STAFF_PASSWORD=seeded-password-1

# OpenAPI / Swagger
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost/api/v1

VITE_APP_NAME="${APP_NAME}"
